# Go sources and scripts keep LF on every platform (gofmt rejects CRLF).
* text=auto eol=lf
*.png binary
*.bz2 binary

# Benchmark evidence is hashed as recorded; never normalize archived bytes.
benchmarks/** -text !eol
benchmarks/corpora/** -whitespace
benchmarks/runs/** -whitespace
benchmarks/reproduction/** -whitespace
benchmarks/artifacts/** -whitespace

# Preserve the reviewed upstream dependency snapshot byte for byte.
third_party/mygo/** -text !eol -whitespace
