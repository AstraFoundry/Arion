  "proposedDecisions": [
    "Automatic-first public disable via a short-lived signed maintenance context, independently verified before deletion; manual SystemSettings recovery only if denied/unverified. Retain files throughout pending states.",
    "Use independent successful public native enumerations and a fresh signed helper, bypassing installed-file-gated product state; unknown/conflicting results retain bytes.",
    "Use capability-checked atomic exchange of complete signed staged/installed bundles and symmetrical rollback; no silent two-rename fallback.",
    "Use cross-process maintenance lock, staged-copy validation, operation generations and explicit transaction recovery; preserve intervening user selection."
  ],
  "limits": [
    "Proposal not implemented; current source still deletes after release and uses two renames.",
    "Independent helper cannot guarantee every other client cache refreshed; lifecycle changes are risk reduction, not proven permanent crash prevention.",
    "Owned filesystem runs are same-parent nonempty unsigned fixtures on one local APFS volume; native arm64 and initial x86_64-process runs are not separate hardware samples.",
    "Unsupported/cross-volume/different-parent/permission, signed-bundle, crash/power-loss and native source/client acceptance remain unexecuted.",
    "No public atomic transaction couples TIS preference state and bundle filesystem deletion."
  ],
  "silentRemovalReview": {
    "publicContract": "TISDisableInputSource is intended for input methods/source-supplying apps and removes sources from selection availability/systemUI; manualSettings not specified as prerequisite.",
    "priorObservation": "Arion desktop process policy denied com.apple.inputsources write; local cache nevertheless reported disabled while freshprocess reported enabled.",
    "scopeLimit": "Actual signed helper and IME-host maintenance attempts have not been verified. No new disable or system mutation performed. A different process is not an assumed policy bypass.",
    "recommendedFlow": "User Remove -> short-lived signed mutation process -> independent fresh public observations -> verified unavailable+hostexit -> delete; denied/unknown -> retain files and offer manual recovery.",
