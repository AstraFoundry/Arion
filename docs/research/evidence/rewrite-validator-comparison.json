    "source": "packages/core/domain/rewrite.go",
    "sha256": "91d919a9de2048ee68480620e1e97257679df13e0634b6d083af46e039650446",
    "revision": "4356914796f484064ffcd562846b7dcd91a1350b",
    "probes": "benchmarks/runs/rewrite-validator-comparison-v1/results.json",
    "rules": {
      "expansion": "candidate letter/digit runes <= floor(source runes * 5/4) + 6",
      "shrink": "candidate runes * 4 >= cleaned-source runes",
      "novelty": "reject novel > 3 and novel * 7 > total CJK-character/Latin-word units",
      "coverage": "require >= 70% cleaned-source character-multiset coverage with declared exceptions",
      "numbers": "candidate digit runs excluding list labels must occur literally in source/terms/context evidence",
      "negation": "candidate recognized-negation count must not decrease"
    },
    "finding": "Scene-independent lexical gates produce both false rejections and false acceptance; authored probes are not LLM inference or semantic accuracy rates."
  }
