  "limitations": [
    "Bounded client handlers only, not whole-program proof of absence.",
    "Service-side validators, prompts and observed inference quality remain unknown.",
    "Chatterfly edit-distance caller and text-validity methods inspected separately from rewrite result delivery."
  ],
  "scope": "Installed-client static validation comparison: Doubao 1.0.2 and Chatterfly 1.0.8; Arion source and authored validator probes",
  "findings": [
    {
      "id": "CVA-CF108-result-policy",
      "evidence": [
        "CVA-CF108-result",
        "CVA-CF108-commit",
        "CVA-CF108-cmode"
      ],
      "observation": "CMode accumulates deltas and uses final response text or the delta buffer. The service success path stores response data.text as enhancedText and reaches commitFinalSpeechText; the commit helper checks mode/focus and delivers enhancedText or a result panel. Bounded methods contain no source/candidate lexical coverage, novelty, number spelling or negation-count gate.",
      "anchors": [
        "0x1003cda1c-0x1003cda64",
        "0x1003cdbf8-0x1003cdc0c",
        "0x1003cec38-0x1003ced44"
      ],
      "limitation": "Not a whole-program or server-side proof of absence. Command/fallback, security errors, insertion verification and target state are separate gates."
    },
    {
      "id": "CVA-CF108-input-validation",
      "evidence": [
        "CVA-CF108-validate-asr",
        "CVA-CF108-validate-asr-callback"
      ],
      "observation": "validateAsrText returns input-length-nonzero OR enablePauseDetect. An empty input without pause detection invokes completion with code 0x765c. No rewritten candidate or similarity comparison is consumed.",
      "anchors": [
        "0x1004243ac-0x1004243c0",
        "0x100424440-0x100424478"
      ]
    },
    {
      "id": "CVA-CF108-edit-metrics",
      "evidence": [
        "CVA-CF108-edit-distance",
        "CVA-CF108-edit-beacon",
        "CVA-CF108-send-edited-text",
        "CVA-CF108-valid-edited-text"
      ],
      "observation": "The edit-distance call is in edit-beacon reporting. p_isValidText trims whitespace and tests nonempty edited text; its inspected caller categorizes edited text in that reporting path. Neither inspected method blocks delivery of the initial rewrite.",
      "anchors": [
        "0x100431e50-0x100431eb0",
        "0x100432648-0x1004326a4"
      ]
    },
    {
      "id": "CVA-DB102-completion",
      "evidence": [
        "DBD-completed",
        "DBD-completion-contract"
      ],
      "observation": "Revalidated existing installed bytes and all six recorded ranges. Completed handler enforces matching request identity, state/decision, completion and nonempty text and handles its timeout. No lexical ratio gate occurs in this bounded handler.",
      "anchors": [
        "0x100be95b4-0x100be9624",
        "0x100be9658-0x100be9730"
      ],
      "limitation": "Other handlers, shared services and server rules remain unknown."
    }
  ],
