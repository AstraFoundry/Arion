{
  "name": "arion-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Native desktop voice input foundation and specifications.",
  "scripts": {
    "check": "node scripts/check-repository.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "docs:check": "node scripts/check-repository.mjs",
    "lint": "node scripts/check-repository.mjs",
    "test": "node scripts/test.mjs",
    "core:check": "node scripts/check-go.mjs core",
    "desktop:check": "node scripts/check-go.mjs desktop",
    "site:check": "pnpm --filter @arion/site check",
    "site:build": "pnpm --filter @arion/site build",
    "site:assets": "pnpm --filter @arion/site assets:build",
    "site:deploy": "pnpm --filter @arion/site deploy",
    "format": "node scripts/check-go.mjs format",
    "preinstall": "node scripts/require-pnpm.mjs",
    "test:tooling": "pnpm --filter @arion/evaluation test",
    "e2e:native": "node scripts/run-native-e2e.mjs",
    "e2e:scenarios": "node tools/evaluation/cli.mjs e2e",
    "bench:plan": "node tools/evaluation/cli.mjs plan",
    "bench:run": "node tools/evaluation/cli.mjs run",
    "bench:report": "node tools/evaluation/cli.mjs report",
    "bench:validate": "node tools/evaluation/cli.mjs validate",
    "datasets:check": "node scripts/check-datasets.mjs",
    "rewrite:plan": "node tools/evaluation/rewrite-cli.mjs plan",
    "rewrite:validate": "node tools/evaluation/rewrite-cli.mjs validate",
    "rewrite:run": "node tools/evaluation/rewrite-cli.mjs run",
    "rewrite:report": "node tools/evaluation/rewrite-cli.mjs report",
    "rewrite:human-export": "node tools/evaluation/rewrite-cli.mjs human-export",
    "rewrite:human-report": "node tools/evaluation/rewrite-cli.mjs human-report",
    "rewrite:e2e": "node tools/evaluation/cli.mjs e2e --suite tests/e2e/contextual-rewrite-scenarios.json",
    "qwen:env": "node scripts/qwen-diagnostic-command.mjs env",
    "qwen:provision": "node scripts/qwen-diagnostic-command.mjs provision",
    "qwen:diagnostic": "node tools/evaluation/qwen-diagnostic.mjs run",
    "qwen:report": "node tools/evaluation/qwen-diagnostic.mjs report",
    "qwen:asr-diagnostic": "node tools/evaluation/diagnostic/asr-run.mjs",
    "qwen:prefix-diagnostic": "node tools/evaluation/diagnostic/prefix-run.mjs",
    "live:fixtures": "node scripts/live-bench-command.mjs fixtures",
    "live:text": "node scripts/live-bench-command.mjs text",
    "live:audio": "node scripts/live-bench-command.mjs audio",
    "live:report": "node scripts/live-bench-command.mjs report",
    "scene:bench": "node scripts/live-bench-command.mjs scene",
    "memory:bench": "node scripts/memory-bench-command.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
