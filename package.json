{
  "name": "arion-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Native desktop voice input foundation and specifications.",
  "scripts": {
    "check": "node scripts/check-repository.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "docs:check": "node scripts/check-repository.mjs",
    "updater:check": "node scripts/check-updater.mjs",
    "updater:e2e": "node scripts/check-updater.mjs --native",
    "notifications:check": "node scripts/check-notifications.mjs",
    "notifications:prepare": "node scripts/check-notifications.mjs --prepare",
    "workflows:check": "node scripts/check-workflows.mjs",
    "lint": "node scripts/check-repository.mjs",
    "test": "node scripts/test.mjs",
    "core:check": "node scripts/check-go.mjs core",
    "desktop:check": "node scripts/check-go.mjs desktop",
    "site:check": "pnpm --filter @arion/site check",
    "site:build": "pnpm --filter @arion/site build",
    "site:assets": "pnpm --filter @arion/site assets:build",
    "site:deploy": "pnpm --filter @arion/site deploy",
    "format": "node scripts/check-go.mjs format",
    "preinstall": "node scripts/require-pnpm.mjs",
    "test:tooling": "pnpm --filter @arion/driver test",
    "e2e:native": "node scripts/run-native-e2e.mjs",
    "e2e:paste": "node scripts/run-native-e2e.mjs --paste",
    "e2e:scenarios": "node tools/driver/cli.mjs e2e",
    "rewrite:e2e": "node tools/driver/cli.mjs e2e --suite tests/e2e/contextual-rewrite-scenarios.json",
    "keyboard:stage": "node scripts/stage-keyboard-runtime.mjs",
    "contributors:update": "node scripts/update-contributors.mjs",
    "keyboard:check": "node scripts/check-keyboard.mjs",
    "keyboard:publisher:check": "node scripts/test-ime-publisher.mjs",
    "keyboard:vocabulary:check": "node scripts/test-ime-publisher.mjs --vocabulary",
    "keyboard:verify": "node scripts/verify-keyboard-bundle.mjs",
    "keyboard:shared:check": "node scripts/check-shared-keyboard.mjs",
    "keyboard:windows:check": "node scripts/check-windows-keyboard.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
