    "failure.capture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone stopped. Another app may be using it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风已停止，可能有其他应用正在使用。"
          }
        }
      }
    },
    "failure.fullAccess": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Allow Full Access for Arion in Settings › General › Keyboard › Keyboards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置 › 通用 › 键盘 › 键盘”中为 Arion 打开“允许完全访问”。"
          }
        }
      }
    },
    "failure.installing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading the speech model. Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载语音模型，请稍后再试。"
          }
        }
      }
    },
    "failure.language": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This language can’t be dictated on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法听写这种语言。"
          }
        }
