{
  "sourceLanguage": "en",
  "strings": {
    "android.failure.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recognizer is busy. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别服务忙，请重试。"
          }
        }
      }
    },
    "android.failure.microphone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Arion to allow the microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开 Arion 允许使用麦克风。"
          }
        }
      }
    },
    "android.failure.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech model for this language isn’t on this phone yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机还没有该语言的语音模型。"
          }
        }
      }
    },
    "android.failure.recognizer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no on-device speech recognizer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机没有设备端语音识别。"
          }
        }
      }
    },
    "android.ime.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arion Voice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arion 语音"
          }
        }
      }
    },
    "android.onboarding.enable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Arion Voice in the list of keyboards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘列表中打开 Arion 语音。"
          }
        }
      }
    },
    "android.onboarding.enable.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android shows a notice for every keyboard you turn on. Arion keeps what you type and say on this phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用任何键盘时，Android 都会显示提醒。Arion 会把你输入和说出的内容保留在这台手机上。"
          }
        }
      }
    },
    "android.onboarding.enable.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open keyboard list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开键盘列表"
          }
        }
      }
    },
    "android.onboarding.enable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the keyboard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用键盘"
          }
        }
      }
    },
    "android.onboarding.select.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Arion Voice as the keyboard you’re using."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Arion 语音设为当前使用的键盘。"
          }
        }
      }
    },
    "android.onboarding.select.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose keyboard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择键盘"
          }
        }
      }
    },
    "android.onboarding.select.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to Arion"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到 Arion"
          }
