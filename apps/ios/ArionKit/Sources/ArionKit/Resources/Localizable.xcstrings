    "onboarding.microphone.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arion listens only while you dictate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arion 只在你听写时收音。"
          }
        }
      }
    },
    "onboarding.microphone.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is off for Arion. Turn it on in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arion 的麦克风权限已关闭，请在“设置”中打开。"
          }
        }
      }
    },
    "onboarding.microphone.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the microphone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许使用麦克风"
          }
        }
      }
    },
    "onboarding.skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后再说"
          }
        }
      }
    },
    "onboarding.try.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to Arion with the globe key, tap the microphone and speak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用地球键切换到 Arion，点按麦克风后说话。"
          }
        }
      }
    },
    "onboarding.try.bodyAndroid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the field, then the microphone on the Arion keyboard, and speak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按输入框，再点按 Arion 键盘上的麦克风，然后说话。"
          }
        }
      }
    },
    "onboarding.try.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your words appear here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说的话会出现在这里"
          }
        }
      }
    },
    "onboarding.try.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试一试"
          }
        }
      }
    },
    "onboarding.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arion turns your voice into clean text in any app. Speech is recognized and polished on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arion 在任何应用里把语音变成干净的文字。识别和润色都在这台设备上完成。"
          }
        }
      }
    },
    "onboarding.welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak, and it’s written."
          }
        },
        "zh-Hans": {
