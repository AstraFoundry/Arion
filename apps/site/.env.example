# Copy to .env.local for local builds. Production values are committed in
# .env.production; build-environment variables override both files. All are
# inlined at build time: change them, then rebuild.

# The site's own origin: canonical URLs, hreflang, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://arion.astrafoundry.si

# The Astra Foundry platform origin. The header and footer link to its account
# portal (/account) and the hosted sync waitlist
# (/products/arion/waitlist/hosted-sync). The site never calls it.
NEXT_PUBLIC_PLATFORM_URL=https://astrafoundry.si
