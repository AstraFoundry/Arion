# Production origins, read by `next build` (NODE_ENV=production). Not secret
# and version-controlled so every build (Workers Builds, GitHub Actions or a
# laptop) produces the same site. A variable set in the build environment
# overrides the value here. See .env.example.

NEXT_PUBLIC_SITE_URL=https://arion.astrafoundry.si
NEXT_PUBLIC_PLATFORM_URL=https://astrafoundry.si
NEXT_PUBLIC_CENTER_URL=https://api.arion.astrafoundry.si
