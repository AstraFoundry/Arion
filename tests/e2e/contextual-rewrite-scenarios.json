{
  "version": 1,
  "scenarios": [
    {
      "id": "rewrite-offline-review-before-once",
      "acceptance": [
        "RWT-A01",
        "RWT-A05",
        "CTR-A06"
      ],
      "capabilities": [
        "local-rewrite",
        "target-editor",
        "native-preview",
        "audio-fixture",
        "network-monitor",
        "rewrite-invariant-inspection"
      ],
      "actions": [
        {
          "op": "reset-owned-fixtures"
        },
        {
          "op": "disable-network"
        },
        {
          "op": "set-rewrite-policy",
          "enabled": true,
          "scenario": "email"
        },
        {
          "op": "focus-editor",
          "id": "A"
        },
        {
          "op": "dictate-fixture",
          "fixture": "rewrite-protected-entities"
        },
        {
          "op": "wait-rewrite-review"
        },
        {
          "op": "inspect-owned-editor",
          "id": "A",
          "checkpoint": "before-confirm"
        },
        {
          "op": "confirm"
        },
        {
          "op": "confirm"
        }
      ],
      "assertions": {
        "rewrite.previewObserved": true,
        "rewrite.protectedConstraintsPassed": true,
        "editors.A.beforeConfirmText": "",
        "rewrite.committedCandidateMatchesPreview": true,
        "commitCount": 1,
        "network.outboundRequests": 0
      }
    },
