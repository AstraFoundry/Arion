        "DSK-A02",
        "CTR-A06",
        "SPH-A06",
        "PRV-A01"
      ],
      "capabilities": [
        "shortcut",
        "audio-fixture",
        "target-editor",
        "network-monitor"
      ],
      "actions": [
        {
          "op": "reset-owned-fixtures"
        },
        {
          "op": "disable-network"
        },
        {
          "op": "focus-editor",
          "id": "A"
        },
        {
          "op": "toggle-recording"
        },
        {
          "op": "play-audio",
          "fixture": "hello-world"
        },
        {
          "op": "stop-recording"
