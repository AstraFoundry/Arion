# Public origin of the center; Caddy obtains its certificate.
ARION_CENTER_DOMAIN=api.arion.astrafoundry.si
ARION_SYNC_POSTGRES_PASSWORD=change-me
ARION_SYNC_ACCOUNT_GATE=oidc
# Read-only credentials for the release bucket the platform publishes.
ARION_UPDATES_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
ARION_UPDATES_S3_REGION=auto
ARION_UPDATES_S3_BUCKET=astrafoundry-releases
ARION_UPDATES_S3_PREFIX=arion
ARION_UPDATES_S3_PATH_STYLE=true
ARION_UPDATES_S3_ACCESS_KEY_ID=
# File holding the secret access key, outside the repository.
ARION_UPDATES_S3_SECRET_FILE=./secrets/updates-s3-secret
