# Copy to .env beside compose.yaml. The password is the only secret this stack requires for noop.
ARION_SYNC_POSTGRES_PASSWORD=change-me
ARION_SYNC_ACCOUNT_GATE=noop
ARION_SYNC_LOG_LEVEL=info

# Hosted relay (api.arion.astrafoundry.si). Device signatures are still required.
# ARION_SYNC_ACCOUNT_GATE=oidc
# ARION_SYNC_OIDC_ISSUER=https://astrafoundry.si
# ARION_SYNC_OIDC_AUDIENCE=https://api.arion.astrafoundry.si
# ARION_SYNC_OIDC_CLIENT_ID=arion-sync
# ARION_SYNC_OIDC_ENTITLEMENT=arion.sync.hosted
