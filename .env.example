# Copied to root .env, this file is loaded by make build desktop and make desktop-dev.
# Shell environment variables take precedence. Leave Apple values empty for preview builds.
ARION_MACOS_SIGNING_IDENTITY=

# Local Mac: use an installed Developer ID certificate/private key and an existing
# notarytool keychain profile. ARION_MACOS_NOTARY_KEYCHAIN is optional.
ARION_MACOS_NOTARY_PROFILE=
ARION_MACOS_NOTARY_KEYCHAIN=

# CI or local import: supply both certificate values and all three APPLE values.
# A temporary keychain is created and removed automatically. The profile defaults
# to arion-notary; leave ARION_MACOS_NOTARY_KEYCHAIN empty in this mode.
MACOS_CERTIFICATE_P12_BASE64=
MACOS_CERTIFICATE_PASSWORD=
APPLE_ID=
APPLE_TEAM_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# Independent Ed25519 update key, matching desktop.json updates.publicKey.
MYGO_UPDATER_PRIVATE_KEY=
