# Copied to root .env, this file is loaded by make build desktop and make desktop-dev.
# Shell environment variables take precedence. Leave Apple values empty for preview builds.
# Required only for macOS desktop-dev. Use a persistent installed code-signing
# identity (full name or SHA-1). No notarization or IME provisioning is required.
MACOS_DEV_SIGNING_IDENTITY=
MACOS_SIGNING_IDENTITY=
# Required for signed builds: an Apple Developer ID macOS profile authorizing
# the IMK host identifier and matching signing certificate. Never commit this file.
MACOS_IME_PROVISIONING_PROFILE=

# Local Mac: use an installed Developer ID certificate/private key and an existing
# notarytool keychain profile. MACOS_NOTARY_KEYCHAIN is optional.
MACOS_NOTARY_PROFILE=
MACOS_NOTARY_KEYCHAIN=

# CI or local import: supply both certificate values and all three APPLE values.
# A temporary keychain is created and removed automatically. The profile defaults
# to astrafoundry; leave MACOS_NOTARY_KEYCHAIN empty in this mode.
MACOS_CERTIFICATE_P12_BASE64=
MACOS_CERTIFICATE_PASSWORD=
APPLE_ID=
APPLE_TEAM_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# Independent Ed25519 update key, matching desktop.json updates.publicKey.
MYGO_UPDATER_PRIVATE_KEY=

# Public center settings are compiled into the package; omit ALL of these for defaults.
# Empty/unrecognized settings are errors. Device-only example:
# ARION_CENTER_URL=https://sync.example.org
# ARION_CENTER_AUTH_MODE=device
# For custom oidc mode, explicitly set all five OIDC fields instead:
# ARION_CENTER_OIDC_ISSUER=https://accounts.example.org
# ARION_CENTER_OIDC_CLIENT_ID=arion-desktop
# ARION_CENTER_OIDC_RESOURCE=https://sync.example.org
# ARION_CENTER_OIDC_SCOPES=openid profile offline_access
# ARION_CENTER_OIDC_ENTITLEMENT=arion.sync.hosted
# Custom-center packages disable the official automatic update channel.
