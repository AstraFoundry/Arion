// The assistant's orb: a glass sphere of colored light, whose blobs drift
// and fold through each other, faster as it thinks, lit from the top left
// with a colored rim and a soft halo around.

var Phase float
// Energy is how lively it is, from 0 (at rest) to 1 (thinking).
var Energy float

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	s := min(size.x, size.y)
	inner := s * 0.5 / 1.25
	uv := (pos - 0.5*size) / inner
	r := length(uv)
	t := Phase

	if r > 1 {
		halo := exp(-(r-1)*5) * (0.25 + 0.2*Energy) * smoothstep(1.25, 1.05, r)
		c := palette(t*0.05 + around(uv, vec2(1)))
		return vec4(c*halo, halo)
	}
	z := sqrt(max(1-r*r, 0))
	n := vec3(uv, z)
	// The light inside, folded about and drifting.
	w := uv * (1.1 + 0.15*z)
	w += (0.22 + 0.25*Energy) * vec2(sin(w.y*2.7+t*1.1), cos(w.x*2.3-t*0.9))
	w += 0.12 * vec2(sin(w.y*5.1-t*1.7), cos(w.x*4.7+t*1.3))
	col := vec3(0.07, 0.04, 0.18)
	for i := 0; i < 5; i++ {
		f := float(i)
		c := 0.6 * vec2(sin(t*(0.5+0.13*f)+f*2.1), cos(t*(0.43+0.11*f)+f*1.3))
		k := exp(-dot(w-c, w-c) * 3.4)
		col += palette(f/5+t*0.03) * k * 0.85
	}
	// Glass: darker toward the rim inside, a colored rim, a highlight.
	rim := pow(1-z, 2.6)
	col *= 0.7 + 0.4*z
	col += palette(around(uv, vec2(1))+t*0.05) * rim * 0.8
	spec := pow(max(dot(n, normalize(vec3(-0.45, -0.6, 0.66))), 0), 60)
	col += vec3(1) * spec * 0.7
	col += vec3(1) * 0.06 * smoothstep(0.3, 1, -uv.y*z)
	alpha := smoothstep(1, 1-1.5/(inner*pixelScale()), r)
	return vec4(min(col, 1)*alpha, alpha)
}
