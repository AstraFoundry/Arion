package main

// The wind at the samples of the texture's field, two to a cell, one
// above the other: a pixel of the canvas each. Its color is what the
// glyphs read of it: how lit (r), which way the air blows there (g and b,
// from 0 for -1 to 1 for 1), and how much of the resting light shows (a).

// The visit's wind: its seed; its time, in seconds; how far the texture
// has come in, from 0 to 1; the heading it blows toward (a unit vector,
// y down); how far it has carried its gusts by now; the span of its long
// swells; the length and width of a gust; and how far its path bends,
// and the size of a bend.
var Seed uint
var Time float
var Reveal float
var Heading vec2
var Carried float
var Span float
var GustLength float
var GustWidth float
var Bend float
var BendScale float

// The pane's size, and the samples': the first's corner and the distance
// between two, in DIPs.
var PaneSize vec2
var Origin vec2
var Step vec2

// The hand: its clock; the clicks' blows (where, when, how hard); and the
// stretches of the pointer's path, their middle, heat and reach (Wakes)
// and their direction and half length (Ways).
var Now float
var TapCount int
var Taps [6]vec4
var WakeCount int
var Wakes [48]vec4
var Ways [48]vec4

const (
	lull     = 0.5
	streak   = 0.4
	detail   = 0.6
	edge     = 0.75
	curl     = 0.65
	wisp     = 0.5
	tail     = 0.35
	sweep    = 0.3
	morph    = 3.0
	cardY    = 0.45
	calmLeft = 0.3
	tau      = 6.2831853
)

func pcg(v uint) uint {
	s := v*747796405 + 2891336453
	w := ((s >> ((s >> 28) + 4)) ^ s) * 277803737
	return (w >> 22) ^ w
}

func unit(h uint) float {
	return float(h>>8) * (1.0 / 16777216.0)
}

func quintic(f vec3) vec3 {
	return f * f * f * (f*(f*6-15) + 10)
}

func corner(h uint) float {
	return unit(pcg(h))*2 - 1
}

// value is value noise from -1 to 1 on an integer lattice hashed with the
// seed.
func value(p vec3, salt uint) float {
	fl := floor(p)
	w := quintic(p - fl)
	x0, x1 := uint(int(fl.x)), uint(int(fl.x)+1)
	y0, y1 := uint(int(fl.y)), uint(int(fl.y)+1)
	z0 := pcg(uint(int(fl.z)) ^ Seed ^ salt)
	z1 := pcg(uint(int(fl.z)+1) ^ Seed ^ salt)
	a, b, c, d := pcg(y0^z0), pcg(y1^z0), pcg(y0^z1), pcg(y1^z1)
	return mix(
		mix(mix(corner(x0^a), corner(x1^a), w.x), mix(corner(x0^b), corner(x1^b), w.x), w.y),
		mix(mix(corner(x0^c), corner(x1^c), w.x), mix(corner(x0^d), corner(x1^d), w.x), w.y),
		w.z)
}

func slope(h uint) vec3 {
	k := pcg(h)
	return vec3(float(k&1023), float((k>>10)&1023), float((k>>20)&1023))*(2.0/1023.0) - 1
}

// swirl is gradient noise on the same lattice, about -1 to 1.
func swirl(p vec3, salt uint) float {
	fl := floor(p)
	f := p - fl
	w := quintic(f)
	x0, x1 := uint(int(fl.x)), uint(int(fl.x)+1)
	y0, y1 := uint(int(fl.y)), uint(int(fl.y)+1)
	z0 := pcg(uint(int(fl.z)) ^ Seed ^ salt)
	z1 := pcg(uint(int(fl.z)+1) ^ Seed ^ salt)
	a, b, c, d := pcg(y0^z0), pcg(y1^z0), pcg(y0^z1), pcg(y1^z1)
	return 1.5 * mix(
		mix(mix(dot(slope(x0^a), f), dot(slope(x1^a), f-vec3(1, 0, 0)), w.x),
			mix(dot(slope(x0^b), f-vec3(0, 1, 0)), dot(slope(x1^b), f-vec3(1, 1, 0)), w.x), w.y),
		mix(mix(dot(slope(x0^c), f-vec3(0, 0, 1)), dot(slope(x1^c), f-vec3(1, 0, 1)), w.x),
			mix(dot(slope(x0^d), f-vec3(0, 1, 1)), dot(slope(x1^d), f-vec3(1)), w.x), w.y),
		w.z)
}

// gusts returns how gusty the air is at a point in the wind's own frame:
// four sizes of gust travelling nearly together, thin strands between,
// and the long swells they gather on.
func gusts(at vec2) float {
	gain := mix(0.38, 0.62, detail)
	gust, weight, power := 0.0, 1.0, 0.0
	size := vec2(0.85*GustLength, 0.75*GustWidth)
	for i := 0; i < 4; i++ {
		k := float(i)
		gust += weight * swirl(vec3((at.x-Carried*(1+0.1*k))/size.x, at.y/size.y, morph*Time*(0.03+0.018*k)+11*k), 0x60+uint(i))
		power += weight * weight
		weight *= gain
		size *= vec2(0.5, 0.58)
	}
	strand := 1 - abs(swirl(vec3((at.x-1.15*Carried)/(0.7*GustLength), at.y/(0.95*GustWidth), morph*Time*0.05+2), 0x66))
	swell := cos((at.x - Carried + 0.5*Span*value(vec3(Time*0.045, at.y/(2.5*GustWidth), 7), 0x67)) * (tau / Span))
	return gust*inversesqrt(power) + wisp*0.5*(strand*strand*strand-0.35) + sweep*swell
}

// heart returns how far out a heart's outline lies in a direction (a unit
// vector, y down), against a circle's 1.
func heart(u vec2) float {
	k := -u.x * u.x * u.y * u.y * u.y
	c := sign(k) * pow(abs(k), 1.0/3)
	r := 1.0
	for i := 0; i < 6; i++ {
		r = sqrt(max(0.05, 1+c*pow(r, 5.0/3)))
	}
	return r
}

// taps returns the clicks' push at p, in DIPs (xy), the wind they raise
// or lower (z) and how roused the air is (w): a click is a blow, whose
// front runs out and slows, shoving the air outward; less than nothing,
// a heart.
func taps(p vec2) vec4 {
	sum := vec4(0)
	for i := 0; i < TapCount; i++ {
		tap := Taps[i]
		age := Now - tap.z
		away := p - tap.xy
		d := length(away)
		reach := d
		if tap.w < 0 {
			reach = d / heart(away/max(d, 1))
		}
		behind := 620*(1-exp(-age/1.3)) - reach
		width := 85 + 60*age
		front := smoothstep(-16, 10, behind) * exp(-behind*behind/(width*width))
		swell := abs(tap.w) * exp(-age/1.5) * front
		sum.xy += away / max(d, 1) * (44 * swell)
		sum.z += 1.9 * swell * (0.25 + 0.75*cos(behind*(tau/130)))
		sum.w += swell
	}
	return sum
}

// warmth returns how warm the pointer's path left the air at p, from 0 to
// 1.
func warmth(p vec2) float {
	w := 0.0
	for i := 0; i < WakeCount; i++ {
		wake := Wakes[i]
		way := Ways[i].xyz
		away := p - wake.xy
		away -= way.xy * clamp(dot(away, way.xy), -way.z, way.z)
		w += wake.z * exp(-dot(away, away)*wake.w)
	}
	return 1 - exp(-1.5*w)
}

func Fragment(dst vec4, pos vec2) vec4 {
	p := Origin + pos*Step
	hand := vec4(0)
	warm := 0.0
	if TapCount+WakeCount > 0 {
		// Read a little off true, so that a ripple's outline is never a
		// drawn circle.
		near := p + 24*vec2(
			value(vec3(p/95, Now*0.12), 0x71),
			value(vec3(p/95+9.1, Now*0.12+4), 0x72))
		hand = taps(near)
		warm = warmth(near)
		hand.zw += vec2(0.25, 0.05) * warm
	}
	// Air that was pushed shows here what was over there, and the wind's
	// path bends, slowly, carrying it along.
	from := p - hand.xy
	turn := vec2(
		value(vec3(from/BendScale, Time*0.04), 0x51),
		value(vec3(from/BendScale+17.3, Time*0.04+5), 0x52))
	bent := from + Bend*turn
	across := vec2(-Heading.y, Heading.x)
	q := vec2(dot(bent, Heading), dot(bent, across))

	// The air curls: small eddies carried on large ones, and the smallest
	// folds, two or three rows of characters across.
	riding := vec2(q.x-0.85*Carried, q.y)
	eddySize, fineSize := 1.15*GustWidth, 0.38*GustWidth
	eddy := vec2(
		swirl(vec3(riding/eddySize, morph*Time*0.04), 0x59),
		swirl(vec3(riding/eddySize+31.7, morph*Time*0.04+3), 0x5a))
	folded := riding + curl*0.9*GustWidth*eddy
	fine := vec2(
		swirl(vec3(folded/fineSize, morph*Time*0.06), 0x5b),
		swirl(vec3(folded/fineSize+13.1, morph*Time*0.06+7), 0x5c))
	creased := (folded + 0.3*GustWidth*fine) / 24
	tiny := vec2(
		swirl(vec3(creased, Time*0.07), 0x5d),
		swirl(vec3(creased+5.3, Time*0.07+1), 0x5e))
	pull := curl * (1 + 0.9*min(hand.w, 1.5)) * (GustWidth*(0.9*eddy+0.3*fine) + detail*30*tiny)
	curled := q + pull
	blows := normalize(Heading + 0.6*turn + hand.xy/14 + curl*((0.45*eddy.x+0.25*fine.x)*Heading+(0.45*eddy.y+0.25*fine.y)*across))

	still := gusts(curled)
	field := still + hand.z
	// Light begins at once on the side a gust heads for and thins out
	// behind it.
	level := mix(0.02, 0.82, lull)
	band := mix(0.26, 0.03, edge)
	blowing := field > level-band-0.55*tail
	strength, streaks := 0.0, 0.0
	if blowing || warm > 0 {
		thread := value(vec3((curled.x-Carried*1.6)/140, curled.y/30, Time*0.16), 0x57)
		streaks = 1 - smoothstep(0, 0.5, abs(thread))
	}
	if blowing {
		ahead := gusts(curled + vec2(56, 0))
		leaving := smoothstep(-0.05, 0.07, ahead-still)
		lit := smoothstep(level-band-0.55*tail*leaving, level+band, field)
		broad := lit * lit * mix(0.45, 1, clamp((field-level)/0.45, 0, 1)) * (0.82 + 0.18*fine.y)
		strength = broad * mix(1, 0.25+0.95*streaks, streak)
	}
	if warm > 0 {
		grain := 0.55*fine.y + 0.45*tiny.x + 0.3*(streaks-0.4)
		strength = 1 - (1-strength)*(1-0.85*warm*smoothstep(-0.5, 0.25, grain))
	}

	// Thinner behind the content.
	e := (p - vec2(0.5*PaneSize.x, cardY*PaneSize.y)) / vec2(250, 80)
	calm := 1 - (1-calmLeft)*exp(-0.9*dot(e, e))
	shown := max(Reveal, min(1, 2*hand.w+warm))
	return vec4(strength*calm*shown, blows*0.5+0.5, calm*shown)
}
