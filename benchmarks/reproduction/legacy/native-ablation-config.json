{
  "version": 1,
  "id": "qwen-pipeline-native-dev",
  "purpose": "Select the default recognition bundle: same corpus, settings and correction-off treatment; only the bundle varies",
  "split": "dev",
  "baseline": "xasr-160",
  "seeds": [
    11
  ],
  "orderSeed": 1729,
  "warmupCount": 2,
  "cacheStates": [
    "warm"
  ],
  "pipeline": {
    "asr": "xasr-160",
    "sampleRate": 16000,
    "chunkMs": 20,
    "endpoint": "sherpa-rules-v1",
    "pace": "realtime",
    "threads": 4,
    "endpointSilenceMs": 800
  },
  "bootstrap": {
    "iterations": 2000,
    "seed": 1729
  },
  "variants": [
    {
      "id": "xasr-160",
      "features": {
        "memory": false,
        "ranker": "source",
        "correction": "none"
      },
      "pipelineOverrides": {
        "asr": "xasr-160"
      }
    },
    {
      "id": "xasr-160-rules",
      "features": {
        "memory": false,
        "ranker": "source",
        "correction": "local"
      },
      "pipelineOverrides": {
        "asr": "xasr-160"
      }
    },
    {
      "id": "xasr-160-xasr-final",
      "features": {
        "memory": false,
        "ranker": "source",
        "correction": "none"
      },
      "pipelineOverrides": {
        "asr": "xasr-160-xasr-final"
      }
    }
  ]
}