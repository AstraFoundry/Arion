{
  "version": 1,
  "id": "edit-learning-asr-test-v1",
  "purpose": "Record held-out test-split recognition with the default bundle, memory off, with and without local rule correction, for offline replay of vocabulary learned from dev-split corrections (edit-learning-v1)",
  "split": "test",
  "baseline": "xasr-160-xasr-final",
  "seeds": [
    11
  ],
  "orderSeed": 1729,
  "warmupCount": 2,
  "cacheStates": [
    "warm"
  ],
  "pipeline": {
    "asr": "xasr-160-xasr-final",
    "sampleRate": 16000,
    "chunkMs": 20,
    "endpoint": "sherpa-rules-v1",
    "pace": "realtime",
    "threads": 4,
    "endpointSilenceMs": 800
  },
  "bootstrap": {
    "iterations": 2000,
    "seed": 1729
  },
  "variants": [
    {
      "id": "xasr-160-xasr-final",
      "features": {
        "memory": false,
        "ranker": "source",
        "correction": "none"
      },
      "pipelineOverrides": {
        "asr": "xasr-160-xasr-final"
      }
    },
    {
      "id": "xasr-160-xasr-final-rules",
      "features": {
        "memory": false,
        "ranker": "source",
        "correction": "local"
      },
      "pipelineOverrides": {
        "asr": "xasr-160-xasr-final"
      }
    }
  ]
}
