{
  "version": 1,
  "id": "edit-learning-cases-v1",
  "provenance": "Developer-authored edit scenarios for ADR 014. Each case is the field right after Arion inserted `inserted` (`baseline`) and the field once the user stopped editing (`settled`). `expect` lists the pairs a correct learner extracts; negatives expect none. No user data, recordings or model output.",
  "cases": [
    {"id": "zh-homophone-term", "kind": "correction", "language": "zh", "inserted": "成功处置深航机上送火事件", "baseline": "新闻：成功处置深航机上送火事件", "settled": "新闻：成功处置深航机上纵火事件", "expect": [{"from": "送火", "to": "纵火"}]},
    {"id": "zh-name", "kind": "correction", "language": "zh", "inserted": "下午和小王开会", "baseline": "下午和小王开会", "settled": "下午和晓王开会", "expect": [{"from": "小王", "to": "晓王"}]},
    {"id": "zh-product-to-latin", "kind": "correction", "language": "mixed", "inserted": "打开阿里昂的设置", "baseline": "打开阿里昂的设置", "settled": "打开Arion的设置", "expect": [{"from": "阿里昂", "to": "Arion"}]},
    {"id": "zh-to-acronym", "kind": "correction", "language": "mixed", "inserted": "先跑一下西爱再合并", "baseline": "先跑一下西爱再合并", "settled": "先跑一下CI再合并", "expect": [{"from": "西爱", "to": "CI"}]},
    {"id": "zh-two-fixes", "kind": "correction", "language": "mixed", "inserted": "把阿里昂的配置发给小王", "baseline": "把阿里昂的配置发给小王", "settled": "把Arion的配置发给晓王", "expect": [{"from": "阿里昂", "to": "Arion"}, {"from": "小王", "to": "晓王"}]},
    {"id": "zh-single-char-widened", "kind": "correction", "language": "zh", "inserted": "收到请回付", "baseline": "收到请回付", "settled": "收到请回复", "expect": [{"from": "回付", "to": "回复"}]},
    {"id": "zh-mid-sentence-in-chat", "kind": "correction", "language": "zh", "inserted": "我已经把文档发到飞输群里了", "baseline": "老板：收到吗\n我已经把文档发到飞输群里了", "settled": "老板：收到吗\n我已经把文档发到飞书群里了", "expect": [{"from": "飞输", "to": "飞书"}]},
    {"id": "zh-tech-term", "kind": "correction", "language": "mixed", "inserted": "用库伯内蒂斯部署这个服务", "baseline": "用库伯内蒂斯部署这个服务", "settled": "用Kubernetes部署这个服务", "expect": [{"from": "库伯内蒂斯", "to": "Kubernetes"}]},
    {"id": "zh-latin-misheard", "kind": "correction", "language": "mixed", "inserted": "把这个 PR MRE 到 main", "baseline": "把这个 PR MRE 到 main", "settled": "把这个 PR merge 到 main", "expect": [{"from": "MRE", "to": "merge"}]},
    {"id": "zh-number-unit", "kind": "correction", "language": "zh", "inserted": "内存涨到了八个字", "baseline": "内存涨到了八个字", "settled": "内存涨到了八个G", "expect": [{"from": "个字", "to": "个G"}]},
    {"id": "en-name-case", "kind": "correction", "language": "en", "inserted": "ask jason about the release", "baseline": "Hi, ask jason about the release", "settled": "Hi, ask Jayson about the release", "expect": [{"from": "jason", "to": "Jayson"}]},
    {"id": "en-brand-split", "kind": "correction", "language": "en", "inserted": "we use open ai models", "baseline": "we use open ai models", "settled": "we use OpenAI models", "expect": [{"from": "open ai", "to": "OpenAI"}]},
    {"id": "en-brand-case", "kind": "correction", "language": "en", "inserted": "the new iphone is out", "baseline": "the new iphone is out", "settled": "the new iPhone is out", "expect": [{"from": "iphone", "to": "iPhone"}]},
    {"id": "en-homophone", "kind": "correction", "language": "en", "inserted": "send it to the sequel database", "baseline": "send it to the sequel database", "settled": "send it to the SQL database", "expect": [{"from": "sequel", "to": "SQL"}]},
    {"id": "en-identifier", "kind": "correction", "language": "en", "inserted": "call get user by id first", "baseline": "call get user by id first", "settled": "call getUserById first", "expect": [{"from": "get user by id", "to": "getUserById"}]},
    {"id": "en-surname", "kind": "correction", "language": "en", "inserted": "Thanks, Mr. Smyth.", "baseline": "Thanks, Mr. Smyth.", "settled": "Thanks, Mr. Smith.", "expect": [{"from": "Smyth", "to": "Smith"}]},
    {"id": "en-two-terms", "kind": "correction", "language": "en", "inserted": "deploy with cube control and helm", "baseline": "deploy with cube control and helm", "settled": "deploy with kubectl and Helm", "expect": [{"from": "cube control", "to": "kubectl"}, {"from": "helm", "to": "Helm"}]},
    {"id": "en-version", "kind": "correction", "language": "en", "inserted": "upgrade to python three twelve", "baseline": "upgrade to python three twelve", "settled": "upgrade to Python 3.12", "expect": [{"from": "python three twelve", "to": "Python 3.12"}]},
    {"id": "en-chat-sent", "kind": "correction", "language": "en", "inserted": "meet at the quay", "baseline": "meet at the quay", "settled": "meet at the Key", "expect": [{"from": "quay", "to": "Key"}]},
    {"id": "en-mid-document", "kind": "correction", "language": "en", "inserted": "the dead line is friday", "baseline": "Notes\n- the dead line is friday\n- budget", "settled": "Notes\n- the deadline is friday\n- budget", "expect": [{"from": "dead line", "to": "deadline"}]},

    {"id": "neg-continue-zh", "kind": "negative", "language": "zh", "inserted": "明天开会", "baseline": "明天开会", "settled": "明天开会，记得带电脑", "expect": []},
    {"id": "neg-continue-en", "kind": "negative", "language": "en", "inserted": "see you tomorrow", "baseline": "see you tomorrow", "settled": "see you tomorrow at the office", "expect": []},
    {"id": "neg-typed-before", "kind": "negative", "language": "zh", "inserted": "明天开会", "baseline": "备注：明天开会", "settled": "重要备注：明天开会", "expect": []},
    {"id": "neg-edit-elsewhere", "kind": "negative", "language": "en", "inserted": "see attached", "baseline": "Dear Tom,\nsee attached", "settled": "Dear Thomas,\nsee attached", "expect": []},
    {"id": "neg-punctuation", "kind": "negative", "language": "zh", "inserted": "好的 我知道了", "baseline": "好的 我知道了", "settled": "好的，我知道了。", "expect": []},
    {"id": "risk-sentence-case", "kind": "risk", "language": "en", "inserted": "ok sounds good", "baseline": "ok sounds good", "settled": "Ok, sounds good!", "expect": [], "note": "Capitalizing a sentence start is formatting, not vocabulary; learning ok → Ok would capitalize it everywhere."},
    {"id": "neg-delete-word", "kind": "negative", "language": "en", "inserted": "this is really good", "baseline": "this is really good", "settled": "this is good", "expect": []},
    {"id": "neg-delete-filler-zh", "kind": "negative", "language": "zh", "inserted": "那个我们明天再说", "baseline": "那个我们明天再说", "settled": "我们明天再说", "expect": []},
    {"id": "neg-insert-word", "kind": "negative", "language": "en", "inserted": "please send report", "baseline": "please send report", "settled": "please send the report", "expect": []},
    {"id": "neg-rewrite", "kind": "negative", "language": "en", "inserted": "let us meet tomorrow at noon", "baseline": "let us meet tomorrow at noon", "settled": "see you friday", "expect": []},
    {"id": "neg-rewrite-zh", "kind": "negative", "language": "zh", "inserted": "我觉得这个方案还可以再改改", "baseline": "我觉得这个方案还可以再改改", "settled": "方案通过", "expect": []},
    {"id": "neg-cleared", "kind": "negative", "language": "en", "inserted": "hello", "baseline": "hello", "settled": "", "expect": []},
    {"id": "neg-deleted-insertion", "kind": "negative", "language": "zh", "inserted": "算了不发了", "baseline": "前文。算了不发了", "settled": "前文。", "expect": []},
    {"id": "neg-unchanged", "kind": "negative", "language": "en", "inserted": "hello there", "baseline": "x hello there", "settled": "x hello there", "expect": []},
    {"id": "neg-many-changes", "kind": "negative", "language": "en", "inserted": "a1 b c d e f g h", "baseline": "a1 b c d e f g h", "settled": "a1 B c D e F g H", "expect": []},
    {"id": "neg-long-insertion", "kind": "negative", "language": "en", "inserted": "please send it", "baseline": "please send it", "settled": "please forward the quarterly planning spreadsheet it", "expect": []},
    {"id": "neg-newline-added", "kind": "negative", "language": "en", "inserted": "first point second point", "baseline": "first point second point", "settled": "first point\nsecond point", "expect": []},
    {"id": "neg-reorder", "kind": "negative", "language": "en", "inserted": "tomorrow we ship", "baseline": "tomorrow we ship", "settled": "we ship tomorrow", "expect": []},
    {"id": "neg-emoji", "kind": "negative", "language": "zh", "inserted": "收到", "baseline": "收到", "settled": "收到👍", "expect": []},
    {"id": "neg-pronoun", "kind": "negative", "language": "zh", "inserted": "我觉得他也同意", "baseline": "我觉得他也同意", "settled": "我觉得她也同意", "expect": [], "note": "他/她 is chosen by meaning; no rule can apply it everywhere."},
    {"id": "neg-lowercase-name", "kind": "negative", "language": "en", "inserted": "ask Cozette now", "baseline": "ask Cozette now", "settled": "ask cozette now", "expect": []},
    {"id": "neg-single-letter", "kind": "negative", "language": "en", "inserted": "merge to M today", "baseline": "merge to M today", "settled": "merge to main today", "expect": []},
    {"id": "neg-not-found", "kind": "negative", "language": "en", "inserted": "hello", "baseline": "goodbye", "settled": "goodbye!", "expect": []},
    {"id": "neg-whole-replaced-single", "kind": "negative", "language": "zh", "inserted": "在", "baseline": "在", "settled": "再", "expect": []},
    {"id": "risk-changed-fact", "kind": "risk", "language": "zh", "inserted": "明天下午三点开会", "baseline": "明天下午三点开会", "settled": "明天下午四点开会", "expect": [], "note": "A changed fact looks like a misrecognition to a text diff; nothing should be learned."},
    {"id": "risk-changed-number-en", "kind": "risk", "language": "en", "inserted": "the budget is 5000 dollars", "baseline": "the budget is 5000 dollars", "settled": "the budget is 6000 dollars", "expect": [], "note": "Edited numbers are content, not spelling."},
    {"id": "risk-changed-word-en", "kind": "risk", "language": "en", "inserted": "let's meet on monday", "baseline": "let's meet on monday", "settled": "let's meet on tuesday", "expect": [], "note": "A different weekday is a change of mind."}
  ]
}
