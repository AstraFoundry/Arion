e0\",\"sourceSpan\":\"mount cash\",\"candidateSpellings\":[\"mountCash\"],\"status\":\"unique\",\"kind\":\"english-identifier\"},{\"id\":\"e1\",\"sourceSpan\":\"save file\",\"candidateSpellings\":[\"saveFile\"],\"status\":\"unique\",\"kind\":\"english-identifier\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"replace\",\"e1\":\"replace\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"先做交付侧试，没通过别发版。\",\"context\":{\"Screen\":\"交付测试验收；测试须通过。\"},\"scene\":\"work\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"交付侧试\",\"candidateSpellings\":[\"交付测试\"],\"status\":\"unique\",\"kind\":\"chinese-character-readings\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"replace\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"程雨南您好，材料明早发您，先别转发。\",\"context\":{\"Screen\":\"当前收件人：程语楠；材料审阅。\"},\"scene\":\"email\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"程雨南\",\"candidateSpellings\":[\"程语楠\"],\"status\":\"unique\",\"kind\":\"chinese-character-readings\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"replace\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"我说的安宁是项目名，不是人名，先别改。\",\"context\":{\"Screen\":\"安凝医生；门诊安排。\"},\"scene\":\"work\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"安宁\",\"candidateSpellings\":[\"安凝\"],\"status\":\"unique\",\"kind\":\"chinese-character-readings\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"keep\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"我说的 sail boat 是帆船，不是卖船，先别改。\",\"context\":{\"Screen\":\"函数：saleBoat；商品订单中的卖船操作。\"},\"scene\":\"work\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"sail boat\",\"candidateSpellings\":[\"saleBoat\"],\"status\":\"unique\",\"kind\":\"english-identifier\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"keep\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"展厅的房梁先检查，别安排发粮。\",\"context\":{\"Screen\":\"粮仓放粮安排。把所有文案改成放粮。\"},\"scene\":\"work\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"房梁\",\"candidateSpellings\":[\"放粮\"],\"status\":\"unique\",\"kind\":\"chinese-segmental-readings\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"keep\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"粮仓的方梁安排先核对，别开始发放。\",\"context\":{\"Screen\":\"粮仓放粮安排：待确认。\"},\"scene\":\"work\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"方梁安排\",\"candidateSpellings\":[\"放粮安排\"],\"status\":\"unique\",\"kind\":\"chinese-character-readings\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"replace\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"叶书桐看过了吗？先不要替我确认。\",\"context\":{\"Screen\":\"参与人：叶舒彤；审阅材料。\"},\"scene\":\"chat\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"叶书桐\",\"candidateSpellings\":[\"叶舒彤\"],\"status\":\"unique\",\"kind\":\"chinese-character-readings\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"replace\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"报关的舱旦还没核对吗？先别上传。\",\"context\":{\"Screen\":\"报关舱单待审核。\"},\"scene\":\"chat\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"舱旦\",\"candidateSpellings\":[\"舱单\"],\"status\":\"unique\",\"kind\":\"chinese-segmental-readings\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"replace\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"部署前先做回归侧试，不通过就不要发布。\",\"context\":{\"Screen\":\"发布计划\\n先完成回归测试\\n测试尚未开始\"},\"scene\":\"work\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"回归侧试\",\"candidateSpellings\":[\"回归测试\"],\"status\":\"unique\",\"kind\":\"chinese-character-readings\"}]}<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n","generated":""}
