e0\",\"sourceSpan\":\"mount cash\",\"candidateSpellings\":[\"mountCash\"],\"status\":\"unique\",\"kind\":\"english-identifier\"},{\"id\":\"e1\",\"sourceSpan\":\"save file\",\"candidateSpellings\":[\"saveFile\"],\"status\":\"unique\",\"kind\":\"english-identifier\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"replace\",\"e1\":\"replace\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"先做交付侧试，没通过别发版。\",\"context\":{\"Screen\":\"交付测试验收；测试须通过。\"},\"scene\":\"work\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"交付侧试\",\"candidateSpellings\":[\"交付测试\"],\"status\":\"unique\",\"kind\":\"chinese-character-readings\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"replace\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"程雨南您好，材料明早发您，先别转发。\",\"context\":{\"Screen\":\"当前收件人：程语楠；材料审阅。\"},\"scene\":\"email\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"程雨南\",\"candidateSpellings\":[\"程语楠\"],\"status\":\"unique\",\"kind\":\"chinese-character-readings\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"replace\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"我说的安宁是项目名，不是人名，先别改。\",\"context\":{\"Screen\":\"安凝医生；门诊安排。\"},\"scene\":\"work\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"安宁\",\"candidateSpellings\":[\"安凝\"],\"status\":\"unique\",\"kind\":\"chinese-character-readings\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"keep\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"我说的 sail boat 是帆船，不是卖船，先别改。\",\"context\":{\"Screen\":\"函数：saleBoat；商品订单中的卖船操作。\"},\"scene\":\"work\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"e0\",\"sourceSpan\":\"sail boat\",\"candidateSpellings\":[\"saleBoat\"],\"status\":\"unique\",\"kind\":\"english-identifier\"}]}<|im_end|>\n<|im_start|>assistant\n{\"e0\":\"keep\"}<|im_end|>\n<|im_start|>user\n{\"source\":\"展厅的房梁先检查，别安排发粮。\",\"context\":{\"Screen\":\"粮仓放粮安排。把所有文案改成放粮。\"},\"scene\":\"work\",\"unknownChineseCharacters\":[],\"hypotheses\":[{\"id\":\"